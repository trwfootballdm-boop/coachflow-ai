{
  "name": "Terminology",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "description": "Reference to Team"
    },
    "category": {
      "type": "string",
      "enum": [
        "formation",
        "motion",
        "route",
        "protection",
        "run_concept",
        "defense_front",
        "coverage",
        "blitz",
        "signal",
        "custom"
      ],
      "description": "Terminology category"
    },
    "key": {
      "type": "string",
      "description": "The term/call used by this team"
    },
    "value": {
      "type": "string",
      "description": "Definition or meaning of the term"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names or codes for this term"
    },
    "position": {
      "type": "string",
      "description": "Position group this applies to e.g. QB, WR, OL"
    },
    "side": {
      "type": "string",
      "enum": [
        "offense",
        "defense",
        "special_teams",
        "all"
      ],
      "default": "offense"
    },
    "sort_order": {
      "type": "integer",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "team_id",
    "category",
    "key",
    "value"
  ]
}