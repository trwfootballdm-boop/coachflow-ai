{
  "name": "Formation",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "description": "Reference to Team"
    },
    "formation_name": {
      "type": "string",
      "description": "Formation name e.g. Shotgun Trips Right"
    },
    "personnel": {
      "type": "string",
      "description": "Personnel grouping e.g. 11, 12, 21"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags for organization"
    },
    "thumbnail_data_url": {
      "type": "string",
      "description": "Base64 data URL or hosted URL for diagram thumbnail"
    },
    "players": {
      "type": "array",
      "description": "Player token positions",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "string",
            "description": "Position code e.g. QB, WR, TE"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "description": "User ID of creator"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a reusable template"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "team_id",
    "formation_name"
  ]
}